# Copy to functions/.env.potent-howl-228108 before deploying Functions.
# This file is intentionally non-secret.  Do not put ESP32 keys, NVR
# credentials, mail credentials, signed URLs, or service-account keys here.

# Private Cloud Run base URL (without a trailing slash).
VIDEO_PROCESSOR_URL=https://video-processor.example.invalid

# The Cloud Tasks OIDC caller identity which is allowed to invoke the private
# Cloud Run service.
VIDEO_TASK_SERVICE_ACCOUNT_EMAIL=video-tasks-invoker@potent-howl-228108.iam.gserviceaccount.com
VIDEO_TASK_LOCATION=europe-west3
VIDEO_TASK_QUEUE=video-clip-processor
VIDEO_TASK_DELAY_SECONDS=15

# ESP32 ingress behaviour.
# Physical ESP32 clips end at the server-recorded press and last 40 seconds.
VIDEO_BUTTON_CLIP_DURATION_SECONDS=40
# Manager-selected clips remain the preceding 10 seconds.
VIDEO_CLIP_LEAD_SECONDS=10
VIDEO_BUTTON_RATE_LIMIT_SECONDS=60
VIDEO_TIMESTAMP_TOLERANCE_SECONDS=90

# Stable private video access. The email link is valid for seven days; each
# Cloud Storage signed redirect created by openVideoClip lasts 15 minutes.
VIDEO_CLIP_BUCKET=potent-howl-228108-video-clips
VIDEO_PUBLIC_BASE_URL=https://europe-west3-potent-howl-228108.cloudfunctions.net/openVideoClip
VIDEO_ACCESS_TTL_SECONDS=604800
VIDEO_SIGNED_URL_TTL_SECONDS=900
