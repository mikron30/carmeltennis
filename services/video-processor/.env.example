# Copy only for local development. Never commit a populated .env file.
# In Cloud Run, bind each secret variable to a Secret Manager secret version.
VIDEO_CLIP_BUCKET=potent-howl-228108-video-clips
GOOGLE_CLOUD_PROJECT=potent-howl-228108

# Use a private HTTPS NVR address or VPN/tunnel endpoint in production.
# HTTP is rejected unless NVR_ALLOW_INSECURE_HTTP=true is explicitly set.
NVR_BASE_URL=https://nvr.example.invalid:8443
NVR_USERNAME=replace-with-secret-manager-binding
NVR_PASSWORD=replace-with-secret-manager-binding
NVR_ALLOW_INSECURE_HTTP=false
NVR_VERIFY_TLS=true
NVR_TIME_ZONE=Asia/Jerusalem
# Enable only for NVR firmware that returns local wall-clock values with a Z suffix.
NVR_SEARCH_RESULTS_ARE_LOCAL_TIME=false
NVR_TRACK_SUFFIX=1
NVR_SEARCH_PATH=/ISAPI/ContentMgmt/search
NVR_DOWNLOAD_PATH=/ISAPI/ContentMgmt/download
NVR_CONNECT_TIMEOUT_SECONDS=15
NVR_READ_TIMEOUT_SECONDS=300

# Court 1 / Left Court -> channel 4; Court 2 / Right Court -> 6;
# Court 3 / Back Court -> 7. Labels are optional after the second colon.
COURT_CAMERA_MAP=1:4:Left Court,2:6:Right Court,3:7:Back Court

# Existing GCP mail-service endpoint. Its bearer token is optional only while
# that legacy service has no authentication; bind one once the service supports it.
MAIL_SERVICE_URL=https://mail-service.example.invalid/sendMail
MAIL_SERVICE_BEARER_TOKEN=replace-with-secret-manager-binding
MAIL_SERVICE_TIMEOUT_SECONDS=30

SIGNED_URL_TTL_SECONDS=604800
SIGNED_URL_SERVICE_ACCOUNT_EMAIL=video-processor-runtime@your-project.iam.gserviceaccount.com
MAX_PROCESSING_ATTEMPTS=5
PROCESSING_LEASE_SECONDS=900
MAX_CLIP_SECONDS=60
MAX_DOWNLOAD_BYTES=500000000
MAX_OUTPUT_BYTES=250000000
FFMPEG_TIMEOUT_SECONDS=600
REQUIRE_CLOUD_TASKS_HEADER=true
